# Конфигурация окружения CryptoTgBot
# Скопируйте этот файл в .env и заполните реальные значения

# Telegram Bot API - ОБЯЗАТЕЛЬНО для Этапа 1
# Получить на https://my.telegram.org/
# 1. Войдите с номером телефона
# 2. Создайте приложение в "API development tools"
# 3. Скопируйте api_id и api_hash
TELEGRAM_API_ID=your_telegram_api_id          # Число, например: 12345678
TELEGRAM_API_HASH=your_telegram_api_hash      # Строка, например: abc123def456ghi789
TELEGRAM_BOT_TOKEN=your_telegram_bot_token    # Получить от @BotFather в Telegram

# Telegram WebApp настройки - для Этапа 1 (базовая версия)
# Для локальной разработки можно использовать ngrok или домен
TELEGRAM_WEBAPP_URL=https://your-domain.com/dashboard    # URL Mini App
TELEGRAM_WEBAPP_DOMAIN=your-domain.com                   # Домен без протокола

# Telegram Bot настройки - для Этапа 1
TELEGRAM_BOT_USERNAME=your_bot_username                    # @username бота без @
TELEGRAM_BOT_DESCRIPTION=CryptoTgBot - интеллектуальный помощник для криптовалютной торговли
TELEGRAM_BOT_SHORT_DESCRIPTION=Автоматическая торговля криптовалютами

# База данных - ОБЯЗАТЕЛЬНО для Этапа 1
# PostgreSQL 18+ должен быть установлен и запущен
# Создать базу данных: CREATE DATABASE cryptobot;
# Создать пользователя: CREATE USER botuser WITH PASSWORD 'your_password';
# Дать права: GRANT ALL PRIVILEGES ON DATABASE cryptobot TO botuser;
DB_PASSWORD=your_secure_db_password                        # Пароль от PostgreSQL
DATABASE_URL=postgresql://botuser:your_secure_db_password@localhost:5432/cryptobot

# Redis - ОБЯЗАТЕЛЬНО для Этапа 1
# Redis должен быть установлен и запущен на localhost:6379
# Пароль можно установить в redis.conf: requirepass your_password
REDIS_PASSWORD=your_secure_redis_password                   # Пароль Redis (если установлен)
REDIS_URL=redis://:your_secure_redis_password@localhost:6379/0

# Безопасность - ОБЯЗАТЕЛЬНО для Этапа 1
# Сгенерировать секретный ключ: openssl rand -hex 32
SECRET_KEY=your_very_secure_secret_key_change_in_production    # 32-байтная строка
ALGORITHM=HS256                                                   # Алгоритм JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30                                    # Срок жизни токена

# Настройки приложения
DEBUG=false                                                      # false для продакшена, true для разработки
APP_NAME=CryptoTgBot
VERSION=1.0.0

# Торговые настройки - для будущих этапов
DEFAULT_EXCHANGE=binance                                         # Биржа по умолчанию
MAX_POSITION_SIZE=100.0                                          # Макс. размер позиции в USDT
RISK_PERCENTAGE=2.0                                             # Риск в % от депозита

# Настройки анализа - для будущих этапов
PATTERN_WINDOW_SIZE=100                                         # Окно для анализа паттернов
SIMILARITY_THRESHOLD=0.85                                       # Порог схожести паттернов

# Домен для Mini App (в продакшене) - для будущих этапов
DOMAIN=your-domain.com                                          # Ваш домен с SSL

# =====================================================================
# БИРЖА (CCXT) — для автоторговли через CCXTExecutor
# =====================================================================
# ВАЖНО: используйте API-ключ с правами ТОЛЬКО на торговлю (Enable Trading),
# НЕ включайте "Enable Withdrawals"! Бот не должен иметь прав на вывод средств.
# Ключ хранится ТОЛЬКО в .env / зашифрованном хранилище, никогда не в коде.
#
# ГДЕ БРАТЬ (пример — Binance):
#   1. Зайти на биржу -> API Management (например https://www.binance.com/en/my/settings/api-management)
#   2. Create API Key -> выбрать "Spot & Margin Trading" (или Futures),
#      НЕ ставить галочку на withdraw
#   3. Скопировать API Key и Secret
#   4. Включить IP-allowlist (рекомендуется) — только твой сервер
# Для Bybit/OKX/etc — аналогично в их API-разделе.
EXCHANGE_ID=binance                          # binance / bybit / okx
EXCHANGE_API_KEY=your_exchange_api_key      # из личного кабинета биржи
EXCHANGE_SECRET=your_exchange_secret         # из личного кабинета биржи
EXCHANGE_MARKET_TYPE=spot                    # spot | future (фьючерсы)
EXCHANGE_TESTNET=true                        # true = песочница биржи (без реальных денег!)
# Для testnet Binance Futures: https://testnet.binancefuture.com/
# Для testnet Bybit: https://testnet.bybit.com/

# =====================================================================
# LLM (локальный llama.cpp server) — для стратегии ai_news
# =====================================================================
# Модель крутится локально через llama.cpp server (собран из llama.cpp-furyx).
# Запуск (на всех ядрах CPU, 40 потоков):
#   cd /home/templard/llama.cpp-furyx && ./build/bin/llama-server \
#     -m /home/templard/.lmstudio/models/qwen2.5-0.5b-instruct-q4_k_m.gguf \
#     --port 8080 -c 4096 -t 40 -tb 40
# Совместимо с OpenAI-API: /v1/chat/completions
TGRODER_LLM_URL=http://localhost:8080       # эндпоинт llama.cpp/LM Studio/ollama
TGRODER_LLM_MODEL=qwen2.5-0.5b-instruct-q4_k_m.gguf  # имя модели в сервере
# Поддерживаемые бэкенды (меняется только URL):
#   llama.cpp:  http://localhost:8080
#   LM Studio:  http://localhost:1234
#   ollama:     http://localhost:11434

