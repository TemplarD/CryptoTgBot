# Конфигурация окружения CryptoTeleBot
# Скопируйте этот файл в .env и заполните реальные значения

# Telegram Bot API
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# База данных
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://botuser:your_secure_db_password@localhost:5432/cryptobot

# Redis
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@localhost:6379/0

# Безопасность
SECRET_KEY=your_very_secure_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Настройки приложения
DEBUG=false
APP_NAME=CryptoTeleBot
VERSION=1.0.0

# Торговые настройки
DEFAULT_EXCHANGE=binance
MAX_POSITION_SIZE=100.0
RISK_PERCENTAGE=2.0

# Настройки анализа
PATTERN_WINDOW_SIZE=100
SIMILARITY_THRESHOLD=0.85

# Домен для Mini App (в продакшене)
DOMAIN=your-domain.com
